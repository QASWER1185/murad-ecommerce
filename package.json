{
  "name": "murad-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:phase4:unit": "tsc -p tsconfig.phase4.json && node --test work/phase4-tests/tests/phase4/unit.test.js",
    "test:phase4:e2e": "tsc -p tsconfig.phase4.json && node scripts/test-phase4.mjs",
    "test:phase3:unit": "tsc -p tsconfig.phase3.json && node --test work/phase3-tests/tests/phase3/policy.test.js",
    "test:phase3:e2e": "node scripts/test-phase3.mjs",
    "test:phase2:policy": "tsc -p tsconfig.phase2.json && node --test work/phase2-tests/tests/phase2/publication.test.js",
    "test:phase2:db": "node scripts/test-phase2.mjs",
    "test:phase2:compat": "node scripts/test-phase2.mjs --with-pr2-columns",
    "test:phase2": "npm run test:phase2:policy && npm run test:phase2:db && npm run test:phase2:compat",
    "test:phase5:unit": "tsc -p tsconfig.phase5.json && node --test work/phase5-tests/tests/phase5/unit.test.js",
    "test:phase5:e2e": "node scripts/test-phase5.mjs",
    "test:phase6:unit": "tsc -p tsconfig.phase6.json && node --test work/phase6-tests/tests/phase6/unit.test.js",
    "test:phase6:e2e": "node scripts/test-phase6.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
